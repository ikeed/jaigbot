# AIMSBot Environment Configuration Template
# Copy this file to .env and fill in the values

# GCP Project Configuration (Optional if set in environment or via gcloud)
# PROJECT_ID=your-gcp-project-id
# REGION=us-central1
VERTEX_LOCATION=global
MODEL_ID=gemini-3.6-flash
AIMS_CLASSIFIER_MODEL_ID=gemini-3.6-flash
# Leave unset: benchmarking found "minimal" ~32% faster but measurably worse at score
# calibration (it awards 3 where the rubric caps at 2). See app/config.py for the numbers.
# AIMS_CLASSIFIER_THINKING_LEVEL=minimal

# Authentication Configuration
# Generate a secret with: chainlit create-secret
CHAINLIT_AUTH_SECRET=your-auth-secret-here

# Session Storage Configuration
SESSIONS_BUCKET_NAME=aimsbot-chat-sessions
# Optional local-dev persistence for MEMORY_BACKEND=memory.
# MEMORY_PERSIST_PATH=.chainlit/session_memory.json

# SSO Configuration (OAuth)
# Uncomment and fill in the provider(s) you want to use.
# Once any OAUTH_*_CLIENT_ID is set, the app will enforce SSO login.

# Google
# OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
# OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook
# OAUTH_FACEBOOK_CLIENT_ID=your-facebook-app-id
# OAUTH_FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Apple
# OAUTH_APPLE_CLIENT_ID=your-apple-services-id
# OAUTH_APPLE_CLIENT_SECRET="-----BEGIN PRIVATE KEY-----\n..."

# Other supported: GITHUB, AZURE_AD, OKTA, AUTH0, KEYCLOAK, COGNITO
# Format: OAUTH_<PROVIDER>_CLIENT_ID and OAUTH_<PROVIDER>_CLIENT_SECRET
